// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js (NextAuth) standard models ---
// Schema follows https://authjs.dev/getting-started/adapters/prisma exactly,
// since @auth/prisma-adapter expects these exact fields/relations.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts      Account[]
  sessions      Session[]
  courses       Course[]
  assignments   Assignment[]
  notifications NotificationItem[]
  mailSyncState MailSyncState?
  links         Link[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App models ---

// A manually-created course, combined with its weekly schedule meeting time.
// Deleting a Course cascades to its Assignments, Grade Categories and Grade Entries.
model Course {
  id         String   @id @default(cuid())
  userId     String
  name       String
  code       String?
  instructor String?
  color      String?
  location   String?
  // ISO weekday numbers restricted to weekdays: 1=Monday ... 5=Friday.
  daysOfWeek Int[]
  // Local wall-clock time-of-day, stored as "HH:mm" (no timezone/date component).
  startTime  String
  endTime    String
  createdAt  DateTime @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments     Assignment[]
  gradeCategories GradeCategory[]
  gradeEntries    GradeEntry[]

  @@index([userId])
}

// A Grade Category: a named, weighted share of a Course's grade (e.g. Exams 40%). A Course's
// Grade Categories are its Grade Scheme. The weights need not total 100 (the UI only warns).
// Deleting one deletes its Grade Entries. Current Grade is derived from these at read time �
// see src/lib/grades/currentGrade.ts � and never stored.
model GradeCategory {
  id        String   @id @default(cuid())
  courseId  String
  name      String
  // Percentage, 0 to 100, decimals allowed.
  weight    Float
  createdAt DateTime @default(now())

  course  Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  entries GradeEntry[]

  @@index([courseId])
}

// A Grade Entry: one score recorded by hand under a Grade Category. Standalone: it has no
// reference to an Assignment. `courseId` duplicates the Category's Course so a Course's
// entries can be counted and cascaded directly; the server actions keep the two consistent.
model GradeEntry {
  id             String    @id @default(cuid())
  courseId       String
  categoryId     String
  name           String
  pointsEarned   Float
  // Greater than zero (enforced by the server actions).
  pointsPossible Float
  // Optional calendar date the score was earned, stored at UTC midnight.
  date           DateTime?
  createdAt      DateTime  @default(now())

  course   Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  category GradeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([categoryId])
}

// A piece of work with a due date that belongs to a Course, entered by hand. Completing it
// deletes the row. Status (Overdue / Due today / Due soon / Upcoming) is derived at read
// time from `dueAt` — see src/lib/assignments/status.ts — and never stored.
model Assignment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  title     String
  notes     String?
  // The due instant. The student's wall-clock due time is resolved to an instant in
  // their own timezone before it is stored.
  dueAt     DateTime
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt])
  @@index([courseId])
}

// A user-added shortcut to an external site (school portal, course tools, etc.),
// shown as a clickable tile on the Links tab.
model Link {
  id        String   @id @default(cuid())
  userId    String
  name      String
  url       String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum NotificationSource {
  EMAIL
}

// A Notification: one email from the student's Outlook account, shown read-only.
model NotificationItem {
  id          String             @id @default(cuid())
  userId      String
  source      NotificationSource
  // Graph message id.
  externalId  String
  // Graph conversationId, for grouping/threading.
  threadId    String?
  subject     String?
  preview     String?
  fromName    String?
  fromAddress String?
  // Graph `webLink`: where "Open in Outlook" goes.
  webLink     String?
  receivedAt  DateTime
  // App-only flag. Seeded from Outlook's read state when the row is first created and never
  // overwritten by a later sync (the app only holds Mail.Read, so it can't write back).
  isRead      Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, externalId])
  @@index([userId, isRead])
}

// Per-user Mail Sync bookkeeping. Written by every sync, manual or automatic (ADR-0002).
model MailSyncState {
  userId         String    @id
  // When the last sync that completed successfully finished. Drives the "last synced" display
  // and the 24-hour auto-sync guard.
  lastSuccessAt  DateTime?
  // When the last sync (successful or not) started. Drives the manual-sync cooldown.
  lastAttemptAt  DateTime?
  // Error message of the last attempt, or null if it succeeded.
  lastError      String?
  // Set when Microsoft rejects the refresh token; auto-sync stays paused until a sync succeeds
  // again after the student reconnects Microsoft.
  needsReconnect Boolean   @default(false)
  // Set while a sync is running, so at most one runs per user. Stale after a few minutes.
  syncStartedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
