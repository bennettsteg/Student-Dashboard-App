// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js (NextAuth) standard models ---
// Schema follows https://authjs.dev/getting-started/adapters/prisma exactly,
// since @auth/prisma-adapter expects these exact fields/relations.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts      Account[]
  sessions      Session[]
  courses       Course[]
  calendarEvents CalendarEvent[]
  notifications NotificationItem[]
  mailSyncState MailSyncState?
  links         Link[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App models ---

// A manually-created course, combined with its weekly schedule meeting time.
// This is the only way a Course comes into existence — Blackboard sync never
// creates or links one (see CalendarEvent.sourceCourseName).
model Course {
  id         String   @id @default(cuid())
  userId     String
  name       String
  code       String?
  color      String?
  location   String?
  // ISO weekday numbers restricted to weekdays: 1=Monday ... 5=Friday.
  daysOfWeek Int[]
  // Local wall-clock time-of-day, stored as "HH:mm" (no timezone/date component).
  startTime  String
  endTime    String
  createdAt  DateTime @default(now())

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  events CalendarEvent[]

  @@index([userId])
}

enum EventSource {
  BLACKBOARD_ICS
  MANUAL
}

enum EventStatus {
  ACTIVE
  CANCELLED
}

model CalendarEvent {
  id           String      @id @default(cuid())
  userId       String
  courseId     String?
  title        String
  description  String?
  location     String?
  startAt      DateTime
  endAt        DateTime
  allDay       Boolean     @default(false)
  source       EventSource
  // Course name as parsed from the Blackboard ICS feed ("Course: Title" prefix).
  // Reference-only display text for BLACKBOARD_ICS events — never linked to a
  // real Course row, since Blackboard sync must never create/match courses.
  sourceCourseName String?
  // iCal UID for BLACKBOARD_ICS events, null for MANUAL events.
  externalUid  String?
  // Dedup key for individual occurrences expanded from a recurring VEVENT.
  recurrenceId String?
  // Hash of the upstream VEVENT fields as last seen; used to skip no-op syncs.
  lastSyncedHash String?
  // Once true, sync must never overwrite this row's content fields again.
  userModified Boolean     @default(false)
  status       EventStatus @default(ACTIVE)
  isAssignment Boolean     @default(false)
  dueAt        DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@unique([userId, source, externalUid, recurrenceId])
  @@index([userId, startAt])
  @@index([courseId, isAssignment, dueAt])
}

// A user-added shortcut to an external site (school portal, course tools, etc.),
// shown as a clickable tile on the Links tab.
model Link {
  id        String   @id @default(cuid())
  userId    String
  name      String
  url       String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum NotificationSource {
  EMAIL
}

// A Notification: one email from the student's Outlook account, shown read-only.
model NotificationItem {
  id          String             @id @default(cuid())
  userId      String
  source      NotificationSource
  // Graph message id.
  externalId  String
  // Graph conversationId, for grouping/threading.
  threadId    String?
  subject     String?
  preview     String?
  fromName    String?
  fromAddress String?
  // Graph `webLink`: where "Open in Outlook" goes.
  webLink     String?
  receivedAt  DateTime
  // App-only flag. Seeded from Outlook's read state when the row is first created and never
  // overwritten by a later sync (the app only holds Mail.Read, so it can't write back).
  isRead      Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, externalId])
  @@index([userId, isRead])
}

// Per-user Mail Sync bookkeeping. Written by every sync, manual or automatic (ADR-0002).
model MailSyncState {
  userId          String    @id
  // When the last sync that completed successfully finished. Drives the "last synced" display
  // and the 24-hour auto-sync guard.
  lastSuccessAt   DateTime?
  // When the last sync (successful or not) started. Drives the manual-sync cooldown.
  lastAttemptAt   DateTime?
  // Error message of the last attempt, or null if it succeeded.
  lastError       String?
  // Set when Microsoft rejects the refresh token; auto-sync stays paused until a sync succeeds
  // again after the student reconnects Microsoft.
  needsReconnect  Boolean   @default(false)
  // Set while a sync is running, so at most one runs per user. Stale after a few minutes.
  syncStartedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
