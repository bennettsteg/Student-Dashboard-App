# Used for local (non-Docker) `npm run dev` / `prisma` CLI usage only. docker-compose.yml
# builds its own internal DATABASE_URL for the app/worker/migrate services from the
# POSTGRES_* vars below, pointed at the `postgres` service - it does not read this value.
DATABASE_URL="postgresql://dashboard:dashboard@localhost:5432/student_dashboard?schema=public"

# Existing Entra ID app registration (multi-tenant + personal accounts).
# Leave AUTH_MICROSOFT_ENTRA_ID_ISSUER unset to use the default "common" issuer,
# which accepts personal, work, and school accounts. Only set it to restrict
# sign-in to a single tenant: https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""

# Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=""
# The app's public base URL; Auth.js builds the Microsoft redirect URI from it.
# Local dev: http://localhost:3000. Deployed: the tailnet HTTPS address from
# `tailscale serve`, e.g. https://<host>.<tailnet>.ts.net (no trailing slash, no port).
# Must match the Entra redirect URI <AUTH_URL>/api/auth/callback/microsoft-entra-id.
# Setting AUTH_URL also makes Auth.js trust the proxied host, so AUTH_TRUST_HOST is not needed.
# See docs/deployment/tailnet-https.md.
AUTH_URL="http://localhost:3000"

# Web Push (Reminders). Generate the key pair ONCE and keep it forever: every enabled device is
# bound to the public key, so changing it breaks all of them (each would need re-enabling).
#   npx web-push generate-vapid-keys        (or: docker compose run --rm worker npx web-push generate-vapid-keys)
# VAPID_SUBJECT identifies you to the push service: mailto:you@example.com or an https URL.
# If left empty it falls back to AUTH_URL when that is https. Leave all three empty to run
# without push (Settings then says push isn't set up). See docs/deployment/push-notifications.md.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# Postgres (used by docker-compose.yml)
POSTGRES_USER="dashboard"
POSTGRES_PASSWORD="dashboard"
POSTGRES_DB="student_dashboard"

# Where Postgres actually stores its data files on the host. Defaults to a folder
# next to the repo, which is fine for local testing but means the data lives on
# whatever disk the repo was cloned onto. On the deploy server, point this at a
# path on the spinning-disk/secondary drive (not the OS/boot SSD), e.g.
# POSTGRES_DATA_DIR="/mnt/hdd/student-dashboard/pgdata"
POSTGRES_DATA_DIR="./data/postgres"
